{
  "name": "@ground-zero-llc/gz-context-engine",
  "version": "0.1.0",
  "description": "Production-grade context engine for AI agents — hybrid RAG, reranking, token-aware assembly, MCP server, eval harness.",
  "author": "Ground Zero LLC <hello@ground-zero.dev>",
  "publisher": "Ground Zero LLC",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gz-context": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
